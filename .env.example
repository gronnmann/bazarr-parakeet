# Local port; when Bazarr is in another Compose project, configure a shared
# Docker network or change LISTEN_ADDRESS to an address reachable by Bazarr.
LISTEN_ADDRESS=127.0.0.1
PORT=9000
CPU_LIMIT=1.0
MEMORY_LIMIT=4g
INFERENCE_THREADS=1

# Default: pinned community ONNX export of Moondream Parakeet Ultra.
MODEL_REPO=altunenes/parakeet-rs
MODEL_REVISION=4d2a8bc71f5c896ec40faa59732e6716295edaf2
MODEL_SUBDIR=parakeet-ultra
MODEL_NAME=ultra
MODEL_ID=parakeet-ultra

CHUNK_SECONDS=30
OVERLAP_SECONDS=2
SUBTITLE_LINE_CHARS=42
SUBTITLE_TARGET_CPS=20
